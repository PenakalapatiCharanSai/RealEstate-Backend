# Server Configuration
PORT=5000
FLASK_ENV=development
SECRET_KEY=your_flask_secret_key_here

# Database Configuration (MongoDB Atlas Cloud Cluster)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.zmg8d.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION_HOURS=24

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Gmail SMTP Email Notification System Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=yourgmail@gmail.com
SMTP_PASSWORD=your_google_app_password
EMAIL_FROM_NAME=HavenSpace Real Estate
EMAIL_FROM_ADDRESS=yourgmail@gmail.com

# Cloudinary Storage Configuration (Optional)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
